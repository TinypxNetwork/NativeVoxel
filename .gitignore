# Publish only the client source, README files and third-party notices.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/src/
!/include/
!/third_party/

# Generated files and local state, including anything created under source folders.
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.a
*.lib
*.pdb
*.class
*.bin
*.png
*.zip
*.jar
*.log
*.tmp
*.part
*.nvpc
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Small downloaded icon used by the README.
!/.github/
/.github/*
!/.github/assets/
/.github/assets/*
!/.github/assets/grass-block.png
