# Publish client source, documentation and the self-contained parity regressions.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.zh-CN.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/src/
!/include/
!/third_party/
!/PARITY.md
!/tests/
/tests/*
!/tests/run.ps1
!/tests/game_tests.cpp
!/tests/simulation_tests.cpp
!/tests/world_io_tests.cpp
!/tests/local_session_tests.cpp
!/tests/sign_editor_tests.cpp

# Generated files and local state, including anything created under source folders.
__pycache__/
*.pyc
*.o
*.obj
*.exe
*.dll
*.a
*.lib
*.pdb
*.class
*.bin
*.png
*.zip
*.jar
*.log
*.tmp
*.part
*.nvpc
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Small downloaded icon used by the README.
!/.github/
/.github/*
!/.github/assets/
/.github/assets/*
!/.github/assets/grass-block.png
