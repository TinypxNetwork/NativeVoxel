    auto outer=[&](Point p){p=rotatePoint(p,1,model.gui3d?-135:0);p=rotatePoint(p,0,model.gui3d?210:180);p[2]=-p[2];return p;};
    Point lights[2]={{.2,1,-.7},{-.2,1,.7}};for(auto& light:lights){const double length=std::sqrt(light[0]*light[0]+light[1]*light[1]+light[2]*light[2]);for(auto& value:light)value/=length;light=rotatePoint(rotatePoint(light,0,165),1,-30);}
    for(const auto& quad:model.geometry.quads){std::array<Point,4> positions;for(unsigned i=0;i<4;++i){const auto& v=quad.vertices[i];Point p={(v.x-.5)*.5*transform[6],(v.y-.5)*.5*transform[7],(v.z-.5)*.5*transform[8]};p=guiRotate(p);for(unsigned a=0;a<3;++a)p[a]+=transform[a];p=outer(p);for(auto& value:p)value*=model.gui3d?20:32;p[0]=(p[0]+8)*2;p[1]=(p[1]+8)*2;positions[i]=p;}Point normal=faceNormals[unsigned(quad.face)];for(unsigned a=0;a<3;++a)normal[a]=std::abs(transform[6+a])>1e-10?normal[a]/transform[6+a]:0;normal=outer(guiRotate(normal));const double length=std::sqrt(normal[0]*normal[0]+normal[1]*normal[1]+normal[2]*normal[2]);for(auto& value:normal)value/=std::max(length,1e-10);double brightness=1;if(model.gui3d){brightness=.4;for(const auto& light:lights){double dot=0;for(unsigned a=0;a<3;++a)dot+=normal[a]*light[a];brightness+=.6*std::max(0.0,dot);}brightness=std::min(1.0,brightness);}const unsigned tint=quad.tintIndex>=0&&quad.tintIndex<5?colors[unsigned(quad.tintIndex)]:0xffffff;
