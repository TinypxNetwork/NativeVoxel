            for(int y=y0;y<=y1;++y)for(int x=x0;x<=x1;++x){const double a=((p[1][1]-p[2][1])*(x+.5-p[2][0])+(p[2][0]-p[1][0])*(y+.5-p[2][1]))/den,b=((p[2][1]-p[0][1])*(x+.5-p[2][0])+(p[0][0]-p[2][0])*(y+.5-p[2][1]))/den,c=1-a-b;if(a<-1e-6||b<-1e-6||c<-1e-6)continue;const double weights[3]={a,b,c},z=a*p[0][2]+b*p[1][2]+c*p[2][2];if(z<depth[y*32+x]-1e-7)continue;double u=0,v=0;for(unsigned i=0;i<3;++i){u+=weights[i]*quad.vertices[indices[i]].u;v+=weights[i]*quad.vertices[indices[i]].v;}const unsigned tx=unsigned(std::clamp(int(u*atlas.width),0,int(atlas.width)-1)),ty=unsigned(std::clamp(int(v*atlas.height),0,int(atlas.height)-1));const auto* sample=atlas.pixels.data()+(std::size_t(ty)*atlas.width+tx)*4;if(sample[3]<=25)continue;auto* destination=output.pixels.data()+(y*32+x)*4;const double alpha=sample[3]/255.0,oldAlpha=destination[3]/255.0,merged=alpha+oldAlpha*(1-alpha);for(unsigned channel=0;channel<3;++channel){const double color=sample[channel]*((tint>>(16-channel*8))&255)/255.0*brightness;destination[channel]=std::uint8_t(std::clamp((color*alpha+destination[channel]*oldAlpha*(1-alpha))/merged,0.0,255.0));}destination[3]=std::uint8_t(merged*255);depth[y*32+x]=z;}
