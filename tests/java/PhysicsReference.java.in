// Test-only headless adapter. Actual movement/collision runs in the supplied
// compiled MCP classes. Placeholders copy the EntityPlayerSP input prelude from
// the supplied Java source; production NativeVoxel never runs Java.
import java.io.*;
import java.util.*;
import com.mojang.authlib.GameProfile;
import net.minecraft.block.Block;
import net.minecraft.block.state.IBlockState;
import net.minecraft.client.multiplayer.ChunkProviderClient;
import net.minecraft.entity.SharedMonsterAttributes;
import net.minecraft.entity.player.EntityPlayer;
import net.minecraft.init.Bootstrap;
import net.minecraft.init.Blocks;
import net.minecraft.potion.Potion;
import net.minecraft.potion.PotionEffect;
import net.minecraft.profiler.Profiler;
import net.minecraft.util.*;
import net.minecraft.world.*;
import net.minecraft.world.chunk.*;
import net.minecraft.world.storage.*;

public final class PhysicsReference {
    static class FixtureWorld extends World {
        final Map<BlockPos, IBlockState> blocks = new HashMap<>();
        final Set<Long> loaded = new HashSet<>();
        FixtureWorld() { this(0); }
        FixtureWorld(int dimension) {
            super(new SaveHandlerMP(), new WorldInfo(new WorldSettings(0L,
                WorldSettings.GameType.SURVIVAL, false, false, WorldType.DEFAULT),
                "native_parity_fixture"), WorldProvider.getProviderForDimension(dimension), new Profiler(), true);
            provider.registerWorld(this);
            chunkProvider = createChunkProvider();
        }
        protected IChunkProvider createChunkProvider() { return new ChunkProviderClient(this); }
        protected int getRenderDistanceChunks() { return 8; }
        protected boolean isChunkLoaded(int x, int z, boolean allowEmpty) {
            return loaded.contains((((long)x) << 32) | (z & 0xffffffffL));
        }
        void load(int x, int z) {
            long key = (((long)x) << 32) | (z & 0xffffffffL);
            if (loaded.add(key)) ((ChunkProviderClient)chunkProvider).loadChunk(x, z);
        }
        void put(int x, int y, int z, int state) {
            load(x >> 4, z >> 4);
            blocks.put(new BlockPos(x, y, z), Block.getBlockById(state >> 4).getStateFromMeta(state & 15));
        }
        public IBlockState getBlockState(BlockPos pos) {
            return blocks.getOrDefault(pos, Blocks.air.getDefaultState());
        }
        // No audio/render subsystem is involved in this world.
        public void playSound(double x, double y, double z, String sound, float volume, float pitch, boolean distant) {}
    }
    static class FixtureInput extends MovementInput {
        float rawForward, rawStrafe;
        boolean rawJump, rawSneak;
        public void updatePlayerMoveState() {
            moveForward = rawForward; moveStrafe = rawStrafe;
            jump = rawJump; sneak = rawSneak;
            if (sneak) {
                moveStrafe = (float)((double)moveStrafe * 0.3D);
                moveForward = (float)((double)moveForward * 0.3D);
            }
        }
    }
    static class FakeKey { boolean down; boolean isKeyDown() { return down; } }
    static class FakeSettings { FakeKey keyBindSprint = new FakeKey(); }
    static class FakeController { boolean spectator; boolean isSpectatorMode() { return spectator; } }
    static class FakeMinecraft {
        FakeSettings gameSettings = new FakeSettings();
        FakeController playerController = new FakeController();
    }
    static class FixturePlayer extends EntityPlayer {
        FixtureInput movementInput = new FixtureInput();
        FakeMinecraft mc = new FakeMinecraft();
        int sprintingTicksLeft, sprintToggleTimer;
        boolean usingItem;
        FixturePlayer(FixtureWorld world) {
            super(world, new GameProfile(new UUID(0, 189), "NativeParity"));
            setPosition(.5, 64, .5); rotationYaw = rotationPitch = 0;
        }
        public boolean isSpectator() { return mc != null && mc.playerController.spectator; }
        public boolean isServerWorld() { return true; }
        public boolean isSneaking() { return movementInput != null && movementInput.sneak; }
        public boolean isUsingItem() { return usingItem; }
        public boolean isCurrentViewEntity() { return true; }
        public void sendPlayerAbilities() {}
        public void playSound(String name, float volume, float pitch) {}
        public boolean inWeb() { return isInWeb; }
        public void setSprinting(boolean value) { super.setSprinting(value); sprintingTicksLeft = value ? 600 : 0; }
        public void updateEntityActionState() {
            moveStrafing = movementInput.moveStrafe;
            moveForward = movementInput.moveForward;
            isJumping = movementInput.jump;
        }
        @PUSH_OUT@
        @OPEN_SPACE@
        public void onLivingUpdate() {
            @SP_TIMERS@
            @SP_MOVEMENT@
            super.onLivingUpdate();
            @SP_FLIGHT_RESET@
        }
        void tick() {
            if (!worldObj.isBlockLoaded(new BlockPos(posX, 0, posZ))) return;
            noClip = isSpectator();
            if (isSpectator()) onGround = false;
            prevPosX = posX; prevPosY = posY; prevPosZ = posZ;
            handleWaterMovement();
            onLivingUpdate();
        }
    }
    public static void main(String[] args) throws Exception {
        Bootstrap.register();
        Locale.setDefault(Locale.ROOT);
        FixtureWorld world = new FixtureWorld();
        FixturePlayer player = new FixturePlayer(world);
        int tick = 0;
        try (BufferedReader input = new BufferedReader(new FileReader(args[0]));
             PrintWriter out = new PrintWriter(new BufferedWriter(new FileWriter(args[1])))) {
            for (String line; (line = input.readLine()) != null;) {
                if (line.isEmpty() || line.charAt(0) == '#') continue;
                String[] f = line.split("\\s+");
                char command = f[0].charAt(0);
                if (command == 'W') { world = new FixtureWorld(); player = new FixturePlayer(world); }
                else if (command == 'B') world.put(Integer.parseInt(f[1]), Integer.parseInt(f[2]), Integer.parseInt(f[3]), Integer.parseInt(f[4]));
                else if (command == 'C') world.load(Integer.parseInt(f[1]), Integer.parseInt(f[2]));
                else if (command == 'P') {
                    player = new FixturePlayer(world);
                    player.setPosition(Double.parseDouble(f[1]), Double.parseDouble(f[2]), Double.parseDouble(f[3]));
                    player.rotationYaw = Float.parseFloat(f[4]); player.rotationPitch = Float.parseFloat(f[5]);
                    player.onGround = f[6].equals("1");
                } else if (command == 'V') {
                    player.motionX = Double.parseDouble(f[1]); player.motionY = Double.parseDouble(f[2]); player.motionZ = Double.parseDouble(f[3]);
                } else if (command == 'A') {
                    player.getEntityAttribute(SharedMonsterAttributes.movementSpeed).setBaseValue(Double.parseDouble(f[1]));
                    player.getFoodStats().setFoodLevel(Integer.parseInt(f[2]));
                    player.capabilities.allowFlying = f[3].equals("1"); player.capabilities.isFlying = f[4].equals("1");
                    player.capabilities.setFlySpeed(Float.parseFloat(f[5])); player.mc.playerController.spectator = f[6].equals("1");
                } else if (command == 'J') {
                    player.removePotionEffect(Potion.jump.id);
                    int amp = Integer.parseInt(f[1]);
                    if (amp >= 0) player.addPotionEffect(new PotionEffect(Potion.jump.id, 100000, amp));
                } else if (command == 'Y') { player.rotationYaw = Float.parseFloat(f[1]); player.rotationPitch = Float.parseFloat(f[2]); }
                else if (command == 'O') {
                    world.getWorldBorder().setCenter(Double.parseDouble(f[1]), Double.parseDouble(f[2]));
                    world.getWorldBorder().setTransition(Double.parseDouble(f[3]));
                    world.getWorldBorder().setSize(Integer.parseInt(f[4]));
                }
                else if (command == 'G') {
                    int x = Integer.parseInt(f[1]), y = Integer.parseInt(f[2]), z = Integer.parseInt(f[3]);
                    BlockPos pos = new BlockPos(x, y, z);
                    IBlockState state = world.getBlockState(pos);
                    // Legacy Block keeps mutable shared bounds. Set the sampled
                    // state explicitly as rendering/ray tracing normally does.
                    state.getBlock().setBlockBoundsBasedOnState(world, pos);
                    List<AxisAlignedBB> boxes = new ArrayList<>();
                    state.getBlock().addCollisionBoxesToList(world, pos, state, new AxisAlignedBB(x - 1, y - 1, z - 1, x + 2, y + 3, z + 2), boxes, player);
                    out.print("G");
                    for (AxisAlignedBB b : boxes) out.printf(" %.17g %.17g %.17g %.17g %.17g %.17g", b.minX, b.minY, b.minZ, b.maxX, b.maxY, b.maxZ);
                    out.println();
                } else if (command == 'S') {
                    float angle = Float.parseFloat(f[1]);
                    out.printf("S %.17g %.17g%n", (double)MathHelper.sin(angle), (double)MathHelper.cos(angle));
                } else if (command == 'T' || command == 'M') {
                    if (command == 'T') {
                        player.movementInput.rawForward = Float.parseFloat(f[1]); player.movementInput.rawStrafe = Float.parseFloat(f[2]);
                        player.movementInput.rawJump = f[3].equals("1"); player.movementInput.rawSneak = f[4].equals("1");
                        player.mc.gameSettings.keyBindSprint.down = f[5].equals("1"); player.usingItem = f[6].equals("1");
                        player.tick();
                    } else player.moveEntity(Double.parseDouble(f[1]), Double.parseDouble(f[2]), Double.parseDouble(f[3]));
                    out.printf("D %d %.17g %.17g %.17g %.17g %.17g %.17g %d %d %d %d %d %d %.17g %d %d %d %d%n",
                        tick++, player.posX, player.posY, player.posZ, player.motionX, player.motionY, player.motionZ,
                        player.onGround ? 1 : 0, player.isCollidedHorizontally ? 1 : 0, player.isCollidedVertically ? 1 : 0,
                        player.isSprinting() ? 1 : 0, player.isSneaking() ? 1 : 0, player.capabilities.isFlying ? 1 : 0,
                        (double)player.fallDistance, player.isInWater() ? 1 : 0, player.isInLava() ? 1 : 0, player.inWeb() ? 1 : 0,
                        player.isOutsideBorder() ? 1 : 0);
                } else throw new IOException("Unknown fixture command: " + line);
            }
        }
    }
}
